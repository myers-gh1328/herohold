<Project>
  <PropertyGroup>
    <HeroholdPdfWorkerOutputDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Herohold.PdfWorker/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)'))</HeroholdPdfWorkerOutputDirectory>
  </PropertyGroup>
  <Target Name="HeroholdCopyPdfWorkerBuild" AfterTargets="Build">
    <Error Condition="!Exists('$(HeroholdPdfWorkerOutputDirectory)/Herohold.PdfWorker.dll')" Text="Build the matching Herohold.PdfWorker configuration before copying its runtime bundle."/>
    <ItemGroup><HeroholdPdfWorkerBuildFiles Include="$(HeroholdPdfWorkerOutputDirectory)/**/*" Exclude="$(HeroholdPdfWorkerOutputDirectory)/**/*.pdb"/></ItemGroup>
    <Copy SourceFiles="@(HeroholdPdfWorkerBuildFiles)" DestinationFiles="@(HeroholdPdfWorkerBuildFiles->'$(OutDir)pdf-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="HeroholdCopyPdfWorkerPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(HeroholdPdfWorkerOutputDirectory)/Herohold.PdfWorker.dll')" Text="Build the matching Herohold.PdfWorker configuration before publishing its runtime bundle."/>
    <ItemGroup><HeroholdPdfWorkerPublishFiles Include="$(HeroholdPdfWorkerOutputDirectory)/**/*" Exclude="$(HeroholdPdfWorkerOutputDirectory)/**/*.pdb"/></ItemGroup>
    <Copy SourceFiles="@(HeroholdPdfWorkerPublishFiles)" DestinationFiles="@(HeroholdPdfWorkerPublishFiles->'$(PublishDir)pdf-worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
</Project>
