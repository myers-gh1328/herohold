<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herohold.Integration.Tests" />
    <InternalsVisibleTo Include="Herohold.Components.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Herohold.Core/Herohold.Core.csproj" />
    <ProjectReference Include="../Herohold.Rules/Herohold.Rules.csproj" />
    <ProjectReference Include="../Herohold.Storage/Herohold.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Herohold.Documents/Herohold.Documents.csproj"/>
    <ProjectReference Include="../Herohold.PdfWorker/Herohold.PdfWorker.csproj" ReferenceOutputAssembly="false"/>
  </ItemGroup>
  <Import Project="../Herohold.Documents/BundlePdfWorker.targets"/>
  <ItemGroup>
    <Content Include="../../data/imported/5etools/*.json" Link="data/imported/5etools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/raw/5etools/races.json" Condition="Exists('../../data/raw/5etools/races.json')" Link="data/raw/5etools/races.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/raw/5etools/feats.json" Condition="Exists('../../data/raw/5etools/feats.json')" Link="data/raw/5etools/feats.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/raw/5etools/items.json" Condition="Exists('../../data/raw/5etools/items.json')" Link="data/raw/5etools/items.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/raw/5etools/items-base.json" Condition="Exists('../../data/raw/5etools/items-base.json')" Link="data/raw/5etools/items-base.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/raw/5etools/spells/spells-xphb.json" Condition="Exists('../../data/raw/5etools/spells/spells-xphb.json')" Link="data/raw/5etools/spells/spells-xphb.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
