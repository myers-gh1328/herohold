<details open="@(Value.HealingDice is not null||Value.ThrownRangeFt is not null)"><summary>Weight, healing, throwing &amp; charges</summary><div class="field-grid">
<label class="field">Weight per item (lb; blank = unknown)<input id="item-unit-weight" type="number" min="0" max="1000000" step="any" value="@Value.UnitWeightLb" disabled="@Official" @onchange="Weight" /></label>
<label class="inline-option"><input id="item-carried" type="checkbox" checked="@Value.Carried" @onchange="e=>Update(Value with{Carried=e.Value is true})" /> Carried by this character</label></div>
<label class="field">Action required to use (from its rules)<select id="item-use-action" value="@Value.UseAction" disabled="@Official" @onchange="ActionCost">@foreach(var action in Enum.GetValues<ItemUseAction>()){<option value="@action">@(action switch{ItemUseAction.TableManaged=>"Not recorded",ItemUseAction.BonusAction=>"Bonus Action",ItemUseAction.None=>"No action",_=>action.ToString()})</option>}</select></label>
<label class="field">Hit points it restores when used (dice, such as 2d4+2; blank = none)<input id="item-healing" maxlength="20" value="@ItemLinking.HealingText(Value)" disabled="@Official" @onchange="Healing" />@if(HealingError){<small class="rust">Write the healing as dice and a bonus, such as 2d4+2.</small>}</label>
<div class="field-grid"><label class="field">Thrown in place of an attack: range in feet (blank = no)<input id="item-thrown-range" type="number" min="5" max="1000" value="@Value.ThrownRangeFt" disabled="@Official" @onchange="ThrownRange" /></label><label class="field">Damage on a failed Dexterity save (such as 1d4 Fire)<input id="item-thrown-damage" maxlength="40" value="@ItemLinking.ThrownDamageText(Value)" disabled="@(Official||Value.ThrownRangeFt is null)" @onchange="ThrownDamage" />@if(ThrownError){<small class="rust">Write the damage as dice and a type, such as 2d6 Acid.</small>}</label></div>
<label class="inline-option"><input id="item-has-charges" type="checkbox" checked="@(Value.Charges is not null)" disabled="@Official" @onchange="e=>Update(Value with{Charges=e.Value is true?new(){Maximum=1,Remaining=1}:null})" /> Uses charges</label>
@if(Value.Charges is {} charges){<div class="field-grid"><label class="field">Maximum charges<input id="item-charge-maximum" type="number" min="1" max="100000" value="@charges.Maximum" disabled="@Official" @onchange="e=>Number(e,n=>charges with{Maximum=n})" /></label><label class="field">Remaining<input id="item-charge-remaining" type="number" min="0" max="@charges.Maximum" value="@charges.Remaining" @onchange="e=>Number(e,n=>charges with{Remaining=n})" /></label><label class="field">Charges per use<input id="item-charge-cost" type="number" min="1" max="@charges.Maximum" value="@charges.UseCost" disabled="@Official" @onchange="e=>Number(e,n=>charges with{UseCost=n})" /></label></div><label class="field">Recharge rule<input maxlength="2000" value="@charges.RecoveryNote" disabled="@Official" @onchange="e=>Update(Value with{Charges=charges with{RecoveryNote=e.Value?.ToString()??string.Empty}})" /></label><p class="small muted">Using this item spends the recorded charge cost. Adjust charges after resolving its recharge rule; rests do not assume a recharge.</p>}
</details>
@code {
    [Parameter,EditorRequired]public EquipmentItem Value {get;set;}=default!;
    [Parameter]public EventCallback<EquipmentItem> ValueChanged {get;set;}
    /// <summary>An official item: only whether it is carried and its charges left can change.</summary>
    [Parameter]public bool Official {get;set;}
    private Task ActionCost(ChangeEventArgs e)=>Enum.TryParse<ItemUseAction>(e.Value?.ToString(),out var cost)?Update(Value with{UseAction=cost}):Task.CompletedTask;
    private Task Update(EquipmentItem item)=>ValueChanged.InvokeAsync(item);
    private bool HealingError,ThrownError;
    private Task ThrownRange(ChangeEventArgs e)=>int.TryParse(e.Value?.ToString(),out var feet)?Update(Value with{ThrownRangeFt=feet}):Update(Value with{ThrownRangeFt=null,ThrownDamage=null,ThrownDamageType=""});
    private Task ThrownDamage(ChangeEventArgs e)
    {
        var text=e.Value?.ToString()??"";ThrownError=false;
        if(string.IsNullOrWhiteSpace(text))return Update(Value with{ThrownDamage=null,ThrownDamageType=""});
        if(ItemLinking.ParseThrownDamage(text) is {} damage)return Update(Value with{ThrownDamage=damage.Dice,ThrownDamageType=damage.Type});
        ThrownError=true;return Task.CompletedTask;
    }
    private Task Healing(ChangeEventArgs e)
    {
        var text=e.Value?.ToString()??"";HealingError=false;
        if(string.IsNullOrWhiteSpace(text))return Update(Value with{HealingDice=null,HealingBonus=0});
        if(ItemLinking.ParseHealing(text) is {} healing)return Update(Value with{HealingDice=healing.Dice,HealingBonus=healing.Bonus});
        HealingError=true;return Task.CompletedTask;
    }
    private Task Weight(ChangeEventArgs e){var text=e.Value?.ToString();return string.IsNullOrWhiteSpace(text)?Update(Value with{UnitWeightLb=null}):decimal.TryParse(text,System.Globalization.NumberStyles.Number,System.Globalization.CultureInfo.InvariantCulture,out var n)?Update(Value with{UnitWeightLb=n}):Task.CompletedTask;}
    private Task Number(ChangeEventArgs e,Func<int,ItemCharges> make)=>int.TryParse(e.Value?.ToString(),out var n)?Update(Value with{Charges=make(n)}):Task.CompletedTask;
}
