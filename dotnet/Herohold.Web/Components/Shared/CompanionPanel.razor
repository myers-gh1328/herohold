@if(Character.Sheet.Adventure.Companions.Count>0){<section class="panel companion-panel"><div class="panel-heading"><h2>Companions</h2><button class="text-link" @onclick="()=>OnEdit.InvokeAsync()">Edit sheets</button></div>
@foreach(var creature in Character.Sheet.Adventure.Companions){<details><summary><strong>@creature.Name</strong> · AC @creature.ArmorClass · @creature.CurrentHp/@creature.MaximumHp HP @if(creature.TemporaryHp>0){<span>+@creature.TemporaryHp temp</span>}</summary><p class="small muted">@creature.Kind · @creature.Speed ft · @creature.Source</p><div class="companion-hp"><input aria-label='@("HP adjustment for "+creature.Name)' type="number" min="1" max="100000" value="@Amount(creature.Id)" @onchange="e=>Amounts[creature.Id]=int.TryParse(e.Value?.ToString(),out var n)?n:1" /><button class="button" disabled="@(Session.IsBusy||creature.CurrentHp==0&&creature.TemporaryHp==0)" @onclick="()=>Hp(creature,-1)">Damage</button><button class="button" disabled="@(Session.IsBusy||creature.CurrentHp==creature.MaximumHp)" @onclick="()=>Hp(creature,1)">Heal</button></div>
@if(creature.Conditions.Count>0){<p class="small">Conditions: @string.Join(", ",creature.Conditions)</p>}@foreach(var action in creature.Actions){<details><summary>@action.Name</summary><p class="small companion-text">@action.Rules</p></details>}@foreach(var resource in creature.Resources){<p class="companion-resource"><span>@resource.Name @resource.Remaining/@resource.Maximum</span><button class="text-link" disabled="@(Session.IsBusy||resource.Remaining==0)" aria-label='@("Spend "+resource.Name+" for "+creature.Name)' @onclick="()=>Resource(creature,resource,-1)">−</button><button class="text-link" disabled="@(Session.IsBusy||resource.Remaining==resource.Maximum)" aria-label='@("Restore "+resource.Name+" for "+creature.Name)' @onclick="()=>Resource(creature,resource,1)">+</button></p>}<p class="small companion-text">@creature.Notes</p></details>}
</section>}
@code{
[Parameter,EditorRequired]public CharacterState Character {get;set;}=default!;[Parameter,EditorRequired]public WorkspaceSession Session {get;set;}=default!;[Parameter]public EventCallback OnEdit {get;set;}
private Dictionary<string,int> Amounts=[];private int Amount(string id)=>Math.Clamp(Amounts.GetValueOrDefault(id,1),1,100000);
private Task Hp(CompanionSheet c,int sign)=>Session.AdjustCompanionHpAsync(c.Id,sign*Amount(c.Id),Character.Id);
private Task Resource(CompanionSheet c,ResourcePool r,int delta)=>Session.AdjustCompanionResourceAsync(c.Id,r.Id,delta,Character.Id);
}
