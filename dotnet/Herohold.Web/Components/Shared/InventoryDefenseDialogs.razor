@inject IJSRuntime JS
@inject IServiceProvider Services
<dialog id="equipment-dialog" class="dialog context-manager-dialog" aria-labelledby="equipment-title"><div class="dialog-inner"><div class="dialog-heading"><h2 id="equipment-title">@(EditingItem?"Edit an item.":"Add to your pack.")</h2><button class="icon-button" aria-label="Close equipment" @onclick='()=>Close("equipment-dialog")'>×</button></div><div class="field-grid"><label class="field">Item name<input id="item-name" list="equipment-name-options" maxlength="160" value="@ItemName" disabled="@(EditingItem&&Official)" @oninput="NameChanged" /><datalist id="equipment-name-options">@foreach(var name in EquipmentNames) { <option value="@name"></option> }</datalist><small class="muted" data-testid="item-catalog-note">@(Official?$"Official item ({OfficialItem!.Source}). Its details come from the rules.":CatalogItemId.Length>0?"Your homebrew item, shared by all your characters.":"Search equipment or enter a custom item.")</small></label><label class="field">Quantity<input type="number" min="0" max="100000" @bind="Quantity" /></label></div><label class="field">Description<textarea rows="3" maxlength="4000" @bind="Description" disabled="@Official"></textarea></label>@if(Kind=="scroll"){<label class="field">Spell on the scroll<input id="item-scroll-spell" maxlength="200" @bind="ScrollSpell" /></label>}<div class="equipment-switches"><label><input type="checkbox" @bind="Consumable" disabled="@Official" /> Consumable</label><label><input type="checkbox" @bind="Equipped" /> Equipped</label><label><input type="checkbox" @bind="RequiresAttunement" disabled="@Official" /> Requires attunement</label>@if(RequiresAttunement) { <label><input type="checkbox" @bind="Attuned" /> Attuned</label> }</div><details class="context-collapsible" open="@(BaseWeapon.Length>0||AttackBonus!=0||DamageBonus!=0)"><summary>Attacks as a weapon</summary><p class="small muted">For a named or magic weapon, pick the weapon it works as. Its attack uses that weapon's damage, properties and your proficiency, plus the bonuses below.</p><div class="field-grid"><label class="field">Works as<select data-testid="item-base-weapon" @bind="BaseWeapon" disabled="@Official"><option value="">Its own name</option>@foreach(var name in WeaponNames) { <option value="@name">@name</option> }</select></label><label class="field">Attack bonus<input data-testid="item-attack-bonus" type="number" min="-20" max="20" @bind="AttackBonus" disabled="@Official" /></label><label class="field">Damage bonus<input data-testid="item-damage-bonus" type="number" min="-20" max="20" @bind="DamageBonus" disabled="@Official" /></label></div></details><details class="context-collapsible"><summary>Confirmed ability modifier bonuses</summary><p class="small muted">These bonuses change modifiers without changing scores. They activate only while the item is equipped and, when required, attuned.</p><div class="ability-editor-grid">@foreach(var ability in Enum.GetValues<Ability>()) { <label class="field">@ability<input type="number" min="-20" max="20" value="@Bonuses.GetValueOrDefault(ability)" disabled="@Official" @onchange="e=>SetBonus(ability,e)" /></label> }</div></details><ItemLoadEditor @key='(ItemId,ItemEditorVersion,"load")' Value="Facts" ValueChanged="SetLoadFacts" Official="Official" />@if(!Official){<ItemFactsEditor @key="(ItemId,ItemEditorVersion)" Busy="Session.IsBusy" Value="Facts" ValueChanged="value=>Facts=value" />}@if(ItemError is { } localItemError){<p role="alert" class="dialog-save-error">@localItemError</p>}@if(Session.Error is { } itemError) { <p role="alert" class="dialog-save-error">@itemError</p> }<div class="form-footer">@if(EditingItem) { <button class="button rust" disabled="@Session.IsBusy" @onclick="RemoveItem">Remove item</button> } else { <span class="small muted">Saved to this character’s inventory</span> }<button class="button primary" disabled="@(Session.IsBusy||string.IsNullOrWhiteSpace(ItemName)||Quantity<0)" @onclick="SaveItem">Save item</button></div></div></dialog>
<dialog id="defenses-dialog" class="dialog context-manager-dialog" aria-labelledby="defenses-title"><div class="dialog-inner"><div class="dialog-heading"><h2 id="defenses-title">@(TargetMode?"Known target defenses.":"Your defenses.")</h2><button class="icon-button" aria-label="Close defenses" @onclick='()=>Close("defenses-dialog")'>×</button></div><p class="small muted">@(TargetMode?"Add resistances, immunities or vulnerabilities you have learned about this target.":"Resistance, immunity, and vulnerability are separate from saving throw bonuses and Advantage.")</p>@if(TargetMode) { <label class="field">Target name<input maxlength="120" @bind="TargetName" /></label><label class="field">Knowledge<select @bind="TargetKnowledge"><option value="unknown">Not checked</option><option value="recorded">Defenses added below</option><option value="none">No special defenses</option></select></label> }<div class="defense-editor-list">@for(var i=0;i<DefenseDraft.Count;i++) { var index=i;var defense=DefenseDraft[i];<div class="change-row" data-testid="@(KnownDefense(defense)?null:"legacy-defense")"><span><strong>@DefensePresentation.Label(defense.Kind): @defense.Type</strong><small class="block muted">@defense.Source · @defense.Note</small>@if(!KnownDefense(defense)){<small class="block muted">Custom defense from your imported sheet.</small>}</span><button type="button" class="text-link" aria-label='@($"Remove {DefensePresentation.Label(defense.Kind).ToLowerInvariant()} {defense.Type} from {defense.Source}")' disabled="@Session.IsBusy" @onclick="()=>DefenseDraft.RemoveAt(index)">Remove</button></div> }</div><div class="field-grid"><label class="field">Kind<select id="defense-kind" value="@DefenseKind" @onchange="ChangeDefenseKind"><option value="resistance">Damage resistance</option><option value="immunity">Damage immunity</option><option value="vulnerability">Damage vulnerability</option><option value="conditionImmunity">Condition immunity</option></select></label><label class="field">Type<select id="defense-type" required value="@DefenseType" @onchange="e=>DefenseType=e.Value?.ToString()??string.Empty"><option value="">Choose @(DefenseKind=="conditionImmunity"?"a condition":"a damage type")</option>@foreach(var type in DefenseTypes){<option value="@type">@type</option>}</select></label></div><label class="field">Source<input id="defense-source" maxlength="160" placeholder="Item, spell, or DM-revealed fact" @bind="DefenseSource" /></label><label class="field">Duration or note<input id="defense-note" maxlength="500" @bind="DefenseNote" /></label><button type="button" class="button section-gap" data-testid="stage-defense" disabled="@(Session.IsBusy||!ValidDefenseChoice)" @onclick="StageDefense">Add defense +</button>@if(Session.Error is { } defenseError) { <p role="alert" class="dialog-save-error">@defenseError</p> }<div class="form-footer"><button class="button" @onclick='()=>Close("defenses-dialog")'>Cancel</button><button class="button primary" data-testid="save-defenses" disabled="@Session.IsBusy" @onclick="SaveDefenses">Save defenses</button></div></div></dialog>

@code {
    [Parameter,EditorRequired] public WorkspaceSession Session {get;set;}=default!;
    private string ItemId="",ItemName="",Description="";
    private EquipmentItem Facts=new();
    private int ItemEditorVersion;
    private string ItemSourceId="";
    private string? ItemError;
    private int Quantity=1,AttackBonus,DamageBonus;
    private string BaseWeapon="";
    private bool Equipped,RequiresAttunement,Attuned,Consumable,EditingItem;
    private Dictionary<Ability,int> Bonuses=[];
    private bool TargetMode;
    private string TargetName="",TargetKnowledge="unknown",DefenseKind="resistance",DefenseType="",DefenseSource="",DefenseNote="";
    private List<DamageDefense> DefenseDraft=[];
    private IReadOnlyList<string> DefenseTypes=>DefenseKind=="conditionImmunity"?SheetRules.ConditionTypes:SheetRules.DamageTypes;
    private bool ValidDefenseChoice=>DefenseKind is "resistance" or "immunity" or "vulnerability" or "conditionImmunity" && DefenseTypes.Contains(DefenseType,StringComparer.Ordinal);
    private static bool KnownDefense(DamageDefense defense)=>(defense.Kind=="conditionImmunity"?SheetRules.ConditionTypes:SheetRules.DamageTypes).Contains(defense.Type,StringComparer.OrdinalIgnoreCase);
    private void ChangeDefenseKind(ChangeEventArgs e){DefenseKind=e.Value?.ToString()??"";DefenseType="";}
    private IEnumerable<string> WeaponNames=>(Session.Items?.Weapons??[]).Concat(BaseWeapon.Length>0?[BaseWeapon]:[]).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);
    private string CatalogItemId="",ScrollSpell="";
    private IReadOnlyList<CatalogItem> Homebrew=[];
    private Dictionary<string,CatalogItem>? officialById,officialByName;
    // Without the rules data there are no official items and every item is homebrew, as in the store.
    private IItemCatalog OfficialItems=>Services.GetService(typeof(IItemCatalog)) as IItemCatalog??EmptyItemCatalog.Instance;
    private Dictionary<string,CatalogItem> OfficialById=>officialById??=OfficialItems.Official.ToDictionary(i=>i.Id,StringComparer.Ordinal);
    // A name in both books is the Player's Handbook item.
    private Dictionary<string,CatalogItem> OfficialByName=>officialByName??=OfficialItems.Official.OrderBy(i=>i.Source=="XPHB"?0:1).GroupBy(i=>i.Definition.Name,StringComparer.OrdinalIgnoreCase).ToDictionary(g=>g.Key,g=>g.First(),StringComparer.OrdinalIgnoreCase);
    private CatalogItem? OfficialItem=>OfficialById.GetValueOrDefault(CatalogItemId);
    private bool Official=>OfficialItem is not null;
    private string Kind=>OfficialItem?.Kind??Homebrew.FirstOrDefault(h=>h.Id==CatalogItemId)?.Kind??"";
    private IEnumerable<string> EquipmentNames=>OfficialByName.Keys.Concat(Homebrew.Select(h=>h.Definition.Name)).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);
    /// <summary>A new item named after an official or homebrew item becomes that item, with its details; any other name is a new homebrew item.</summary>
    private void NameChanged(ChangeEventArgs e)
    {
        ItemName=e.Value?.ToString()??"";if(EditingItem)return;
        var known=OfficialByName.GetValueOrDefault(ItemName.Trim())??Homebrew.FirstOrDefault(h=>h.Definition.Name.Equals(ItemName.Trim(),StringComparison.OrdinalIgnoreCase));
        if(known is null){CatalogItemId="";return;}
        var d=known.Definition;CatalogItemId=known.Id;Description=d.Description;Consumable=d.Consumable;RequiresAttunement=d.RequiresAttunement;Attuned&=d.RequiresAttunement;
        BaseWeapon=d.BaseWeapon;AttackBonus=d.AttackBonus;DamageBonus=d.DamageBonus;Bonuses=new(d.ModifierBonuses);ItemEditorVersion++;
        Facts=Facts with{UnitWeightLb=d.UnitWeightLb,UseAction=d.UseAction,Charges=d.Charges is {} charges?charges with{Remaining=charges.Maximum}:null,Defenses=[..d.Defenses],PassiveEffects=[..d.PassiveEffects],UseEffects=[..d.UseEffects]};
    }
    private Task Close(string id)=>JS.InvokeVoidAsync("heroholdUi.closeDialog",id).AsTask();
    public async Task OpenItemAsync(EquipmentItem? item=null)
    {
        ItemEditorVersion++;ItemSourceId=Session.Character!.Id;ItemError=null;Facts=item is null?new():item with{Defenses=item.Defenses.Select(d=>d with{}).ToList(),PassiveEffects=item.PassiveEffects.Select(e=>e with{}).ToList(),UseEffects=item.UseEffects.Select(e=>e with{}).ToList()};
        EditingItem=item is not null;ItemId=item?.Id??Guid.NewGuid().ToString("N");ItemName=item?.Name??"";Description=item?.Description??"";Quantity=item?.Quantity??1;Equipped=item?.Equipped??false;RequiresAttunement=item?.RequiresAttunement??false;Attuned=item?.Attuned??false;Consumable=item?.Consumable??false;Bonuses=item is null?[]:new(item.ModifierBonuses);BaseWeapon=item?.BaseWeapon??"";AttackBonus=item?.AttackBonus??0;DamageBonus=item?.DamageBonus??0;
        CatalogItemId=item?.CatalogItemId??"";ScrollSpell=item?.ScrollSpell??"";Homebrew=await Session.HomebrewItemsAsync();
        if(Session.Items is null)await Session.LoadCatalogAsync();
        await InvokeAsync(StateHasChanged);await JS.InvokeVoidAsync("heroholdUi.openDialog","equipment-dialog");
    }
    private void SetLoadFacts(EquipmentItem value){Facts=value;if(!value.Carried){Equipped=false;Attuned=false;}}
    private void SetBonus(Ability ability,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var n))Bonuses[ability]=n;}
    private bool ItemSourceMatches(){if(ItemSourceId==Session.Character?.Id)return true;ItemError="This item editor belongs to another character. Reopen it for the selected character.";return false;}
    private async Task SaveItem(){if(Session.IsBusy||!ItemSourceMatches())return;var item=Facts with{Id=ItemId,Name=ItemName,Description=Description,Quantity=Quantity,Equipped=Facts.Carried&&Equipped,RequiresAttunement=RequiresAttunement,Attuned=Facts.Carried&&RequiresAttunement&&Attuned,Consumable=Consumable,BaseWeapon=BaseWeapon,AttackBonus=AttackBonus,DamageBonus=DamageBonus,ModifierBonuses=Bonuses.Where(p=>p.Value!=0).ToDictionary(),CatalogItemId=CatalogItemId,ScrollSpell=ScrollSpell};if(EditingItem)await Session.UpdateEquipmentAsync(item);else await Session.AddEquipmentAsync(item);if(Session.Error is null)await Close("equipment-dialog");}
    private async Task RemoveItem(){if(Session.IsBusy||!ItemSourceMatches())return;await Session.RemoveEquipmentAsync(ItemId);if(Session.Error is null)await Close("equipment-dialog");}
    public async Task OpenDefensesAsync(bool target=false)
    {
        TargetMode=target;DefenseKind="resistance";var c=Session.Character!;DefenseDraft=[..target?c.KnownTarget.Defenses:c.Defenses];TargetName=c.KnownTarget.Name;TargetKnowledge=c.KnownTarget.Knowledge;DefenseType="";DefenseSource="";DefenseNote="";
        await InvokeAsync(StateHasChanged);await JS.InvokeVoidAsync("heroholdUi.openDialog","defenses-dialog");
    }
    private void StageDefense(){if(Session.IsBusy||!ValidDefenseChoice)return;DefenseDraft.Add(new DamageDefense{Kind=DefenseKind,Type=DefenseType.Trim(),Source=DefenseSource,Note=DefenseNote});DefenseType="";DefenseSource="";DefenseNote="";if(TargetMode)TargetKnowledge="recorded";}
    private async Task SaveDefenses(){if(TargetMode)await Session.SetKnownTargetAsync(new KnownTargetState{Name=TargetName,Knowledge=TargetKnowledge,Defenses=[..DefenseDraft]});else await Session.SetDefensesAsync([..DefenseDraft]);if(Session.Error is null)await Close("defenses-dialog");}
}
