@inject IJSRuntime JS
<dialog id="adventure-facts-dialog" class="dialog" aria-labelledby="adventure-facts-title"><div class="dialog-inner">
<div class="dialog-heading"><h2 id="adventure-facts-title">Travel &amp; companions</h2><button class="icon-button" aria-label="Close travel" @onclick="Close">×</button></div>
@if(Opened)
{
    <section><h3>Movement</h3><p class="small muted">Record speeds granted by your features, equipment or spells. Exhaustion applies to the displayed speed; enter the base speed here.</p>
    @foreach(var mode in Facts.Movement){<div class="change-row"><span>@mode.Kind @mode.Speed ft · @mode.Source<small class="block muted">@mode.Note</small></span><button class="text-link" @onclick="()=>RemoveMovement(mode.Kind)">Remove</button></div>}
    <div class="field-grid"><label class="field">Mode<select id="travel-mode-kind" @bind="ModeKind"><option>Climb</option><option>Swim</option><option>Fly</option><option>Burrow</option></select></label><label class="field">Base speed (ft)<input id="travel-mode-speed" type="number" min="0" max="10000" @bind="ModeSpeed" /></label></div>
    <label class="field">Source<input maxlength="500" @bind="ModeSource" /></label><label class="field">Restrictions / duration<input maxlength="2000" @bind="ModeNote" /></label><button class="button" data-testid="stage-movement" @onclick="StageMovement">Stage movement</button></section>
    <details><summary>Carrying capacity</summary><p class="small muted">Capacity uses Strength and size. Record an override only for a rule that changes it. Unknown item weights remain uncounted. This does not apply the 2014 variant encumbrance rules.</p>
    <label class="field">Capacity override (lb, blank uses size and Strength)<input id="capacity-override" type="number" min="0" max="100000000" @bind="Capacity" /></label><label class="field">Override source<input maxlength="500" @bind="CapacitySource" /></label><label class="inline-option"><input type="checkbox" @bind="CarryCoins" /> Count coins in carried weight (50 coins = 1 lb)</label></details>
    <section><h3>Companions</h3><p class="small muted">Keep a companion, familiar or summon sheet. Use its actual stat block and summoning rule for actions and commands; these records do not grant an extra character action.</p>
    @foreach(var creature in Facts.Companions){<div class="change-row"><span><strong>@creature.Name</strong> · @creature.Kind · AC @creature.ArmorClass · @creature.CurrentHp/@creature.MaximumHp HP</span><span><button class="text-link" @onclick="()=>EditCompanion(creature)">Edit</button> <button class="text-link" aria-label='@("Remove "+creature.Name)' @onclick="()=>RemoveCompanion(creature.Id)">Remove</button></span></div>}
    <details open="@EditingCreature"><summary>@(CreatureId.Length>0?"Edit companion":"Add companion")</summary>
    <div class="field-grid"><label class="field">Name<input id="companion-name" maxlength="200" @bind="CreatureName" @bind:event="oninput" /></label><label class="field">Kind<select @bind="CreatureKind"><option>Companion</option><option>Familiar</option><option>Summon</option><option>Mount</option></select></label></div>
    <div class="field-grid"><label class="field">Maximum HP<input id="companion-maximum" type="number" min="1" max="100000" @bind="CreatureMax" /></label><label class="field">Current HP<input id="companion-current" type="number" min="0" max="@CreatureMax" @bind="CreatureHp" /></label><label class="field">Temporary HP<input type="number" min="0" max="100000" @bind="CreatureTemp" /></label><label class="field">Armor class<input type="number" min="0" max="100" @bind="CreatureAc" /></label><label class="field">Speed (ft)<input type="number" min="0" max="10000" @bind="CreatureSpeed" /></label></div>
    <label class="field">Stat block / source<input maxlength="500" @bind="CreatureSource" /></label><label class="field">Notes<textarea rows="3" maxlength="12000" @bind="CreatureNotes"></textarea></label><label class="field">Conditions (comma separated)<input maxlength="2000" @bind="CreatureConditions" /></label>
    <h4>Actions &amp; commands</h4>@foreach(var action in CreatureActions){<div class="change-row"><span><strong>@action.Name</strong><small class="block">@action.Rules</small></span><button class="text-link" @onclick="()=>CreatureActions.Remove(action)">Remove</button></div>}
    <label class="field">Action name<input maxlength="200" @bind="ActionName" /></label><label class="field">Action rules<textarea rows="2" maxlength="12000" @bind="ActionRules"></textarea></label><button class="button" disabled="@(string.IsNullOrWhiteSpace(ActionName)||CreatureActions.Count>=50)" @onclick="StageAction">Add action</button>
    <h4>Resource counters</h4>@foreach(var resource in CreatureResources){<div class="change-row"><span>@resource.Name @resource.Remaining/@resource.Maximum</span><button class="text-link" @onclick="()=>CreatureResources.Remove(resource)">Remove</button></div>}
    <div class="field-grid"><label class="field">Counter name<input maxlength="200" @bind="ResourceName" /></label><label class="field">Maximum<input type="number" min="0" max="100000" @bind="ResourceMax" /></label><label class="field">Remaining<input type="number" min="0" max="@ResourceMax" @bind="ResourceRemaining" /></label></div><button class="button" disabled="@(string.IsNullOrWhiteSpace(ResourceName)||ResourceRemaining<0||ResourceRemaining>ResourceMax||CreatureResources.Count>=50)" @onclick="StageResource">Add counter</button>
    <div class="form-footer"><button class="button" @onclick="ResetCreature">Clear editor</button><button class="button" data-testid="stage-companion" disabled="@(string.IsNullOrWhiteSpace(CreatureName)||CreatureMax<1||CreatureHp<0||CreatureHp>CreatureMax)" @onclick="StageCompanion">Stage companion</button></div></details></section>
    @if(Error is not null){<p role="alert">@Error</p>}@if(Session.Error is not null){<p role="alert">@Session.Error</p>}
    <div class="form-footer"><button class="button" @onclick="Close">Cancel</button><button class="button primary" data-testid="save-adventure" disabled="@Session.IsBusy" @onclick="Save">Save changes</button></div>
}
</div></dialog>
@code {
    [Parameter,EditorRequired]public WorkspaceSession Session {get;set;}=default!;
    private bool Opened,EditingCreature;private string SourceId="";private AdventureFacts Facts=new();private string? Error;
    private string ModeKind="Climb",ModeSource="",ModeNote="",CapacitySource="";private int ModeSpeed=30;private decimal? Capacity;private bool CarryCoins;
    private string CreatureId="",CreatureName="",CreatureKind="Companion",CreatureSource="",CreatureNotes="",CreatureConditions="",ActionName="",ActionRules="",ResourceName="";
    private int CreatureMax=1,CreatureHp=1,CreatureAc=10,CreatureTemp,CreatureSpeed=30,ResourceMax=1,ResourceRemaining=1;
    private List<CompanionAction> CreatureActions=[];private List<ResourcePool> CreatureResources=[];
    public async Task OpenAsync(){SourceId=Session.Character!.Id;Facts=System.Text.Json.JsonSerializer.Deserialize<AdventureFacts>(System.Text.Json.JsonSerializer.Serialize(Session.Character.Sheet.Adventure))!;Capacity=Facts.CapacityOverrideLb;CapacitySource=Facts.CapacitySource;CarryCoins=Facts.CarryCoins;Error=null;Opened=true;ResetCreature();await InvokeAsync(StateHasChanged);await JS.InvokeVoidAsync("heroholdUi.openDialog","adventure-facts-dialog");}
    private Task Close()=>JS.InvokeVoidAsync("heroholdUi.closeDialog","adventure-facts-dialog").AsTask();
    private void StageMovement(){if(ModeSpeed is <0 or >10000)return;Facts=Facts with{Movement=[..Facts.Movement.Where(m=>m.Kind!=ModeKind),new(){Kind=ModeKind,Speed=ModeSpeed,Source=ModeSource,Note=ModeNote}]};}
    private void RemoveMovement(string kind)=>Facts=Facts with{Movement=Facts.Movement.Where(m=>m.Kind!=kind).ToList()};
    private void RemoveCompanion(string id)=>Facts=Facts with{Companions=Facts.Companions.Where(p=>p.Id!=id).ToList()};
    private void ResetCreature(){CreatureId="";CreatureName="";CreatureKind="Companion";CreatureSource="";CreatureNotes="";CreatureConditions="";CreatureMax=CreatureHp=1;CreatureAc=10;CreatureTemp=0;CreatureSpeed=30;CreatureActions=[];CreatureResources=[];EditingCreature=false;}
    private void EditCompanion(CompanionSheet c){CreatureId=c.Id;CreatureName=c.Name;CreatureKind=c.Kind;CreatureSource=c.Source;CreatureNotes=c.Notes;CreatureConditions=string.Join(", ",c.Conditions);CreatureMax=c.MaximumHp;CreatureHp=c.CurrentHp;CreatureAc=c.ArmorClass;CreatureTemp=c.TemporaryHp;CreatureSpeed=c.Speed;CreatureActions=c.Actions.Select(a=>a with{}).ToList();CreatureResources=c.Resources.Select(r=>r with{}).ToList();EditingCreature=true;}
    private void StageAction(){if(!string.IsNullOrWhiteSpace(ActionName)){CreatureActions.Add(new(){Name=ActionName.Trim(),Rules=ActionRules});ActionName=ActionRules="";}}
    private void StageResource(){if(!string.IsNullOrWhiteSpace(ResourceName)){CreatureResources.Add(new(){Id=Guid.NewGuid().ToString("N"),Name=ResourceName.Trim(),Maximum=ResourceMax,Remaining=ResourceRemaining});ResourceName="";}}
    private void StageCompanion(){if(string.IsNullOrWhiteSpace(CreatureName)||CreatureMax<1||CreatureHp<0||CreatureHp>CreatureMax)return;var id=CreatureId.Length>0?CreatureId:Guid.NewGuid().ToString("N");var creature=new CompanionSheet{Id=id,Name=CreatureName.Trim(),Kind=CreatureKind,Source=CreatureSource,Notes=CreatureNotes,MaximumHp=CreatureMax,CurrentHp=CreatureHp,TemporaryHp=CreatureTemp,ArmorClass=CreatureAc,Speed=CreatureSpeed,Conditions=CreatureConditions.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Distinct().ToList(),Actions=CreatureActions.Select(a=>a with{}).ToList(),Resources=CreatureResources.Select(r=>r with{}).ToList()};Facts=Facts with{Companions=[..Facts.Companions.Where(p=>p.Id!=id),creature]};ResetCreature();}
    private async Task Save(){if(!string.IsNullOrWhiteSpace(CreatureName)){Error="Stage the companion changes before saving, or clear its editor.";return;}await Session.UpdateAdventureAsync(Facts with{CapacityOverrideLb=Capacity,CapacitySource=CapacitySource,CarryCoins=CarryCoins},SourceId);if(Session.Error is null)await Close();}
}
