@page "/"
@implements IDisposable
@inject WorkspaceSession Session
@inject IJSRuntime JS

<PageTitle>Herohold — character companion</PageTitle>
<div class="app context-ready player-workspace">
    <div class="main-wrap">
        @if(Session.Error is not null)
        {
            <div class="workspace-error" role="alert"><strong>Your change was not saved.</strong> @Session.Error <button class="text-link" @onclick="Reload" disabled="@Session.IsBusy">Reload saved character →</button></div>
        }
        @if(Character is { } c)
        {
            var archivedNoteIds=JournalRules.ArchivedNoteIds(c);
            <dialog id="app-drawer" class="dialog app-drawer" aria-labelledby="app-drawer-title"><div class="dialog-inner"><div class="dialog-heading"><h2 id="app-drawer-title">Herohold</h2><button class="icon-button" aria-label="Close application menu" @onclick='()=>CloseDialog("app-drawer")'>×</button></div><p class="small muted">Characters &amp; application settings</p><label><span class="sr-only">Color theme</span><select aria-label="Color theme" data-testid="theme" value="@Theme" @onchange="ChangeTheme"><option value="system">System theme</option><option value="light">Light</option><option value="dark">Dark</option></select></label><div data-testid="character-menu" class="drawer-actions"><button class="button" @onclick="OpenDetails">Details, edit &amp; level up</button><button class="button" data-testid="open-profile" @onclick="OpenProfile">Profile, story &amp; training</button><button class="button" data-testid="open-references" @onclick="OpenReferences">Languages, training &amp; features</button><button class="button" data-testid="open-purse" @onclick="OpenPurse">Coin purse</button><button class="button" data-testid="open-survival" @onclick="OpenSurvival">Survival &amp; inspiration</button><button class="button" @onclick="()=>OpenHealth(HealthChangeKind.TemporaryHp)">Temporary HP</button><button class="button" @onclick='()=>Navigate("library")'>Character library</button><button class="button" data-testid="menu-import" @onclick="OpenImport">Import a character</button><hr /><button class="button" data-testid="export-json" disabled="@Session.IsBusy" @onclick='()=>Export("json")'>Export character JSON</button><button class="button" data-testid="export-pdf" disabled="@Session.IsBusy" @onclick='()=>Export("pdf")'>Export editable PDF</button><button class="button" disabled="@Session.IsBusy" @onclick="Reload">Reload saved character</button></div></div></dialog>
            <div class="player-toolbar">
                <header id="character-context" class="player-header" aria-label="Active character and quick actions">
                    <div class="player-identity"><button class="icon-button drawer-toggle" data-testid="open-app-drawer" aria-label="Open application menu" @onclick='()=>JS.InvokeVoidAsync("heroholdUi.openDialog","app-drawer").AsTask()'>☰</button><button class="player-name" @onclick="OpenDetails" aria-label='@("Character details for "+c.Name)'>@c.Name</button><p>@c.Species · @ClassSummary(c) @if(!string.IsNullOrWhiteSpace(c.Subclass)){<span>· @c.Subclass</span>}</p></div>
                    <div class="dice-center"><label class="sheet-dice-preference"><span class="sr-only">Dice</span><select data-testid="preferred-dice-mode" aria-label="Preferred dice mode" @bind="PreferredDiceMode"><option value="@DiceMode.Digital">Roll digitally</option><option value="@DiceMode.Physical">Use my own dice</option></select></label><button class="button" data-testid="next-roll-options" @onclick="OpenNextRollOptions">@(Gameplay?.NextRollSummary??"Roll options")</button></div><div class="player-vitals"><div class='@("health-emblem "+HealthTone(c))' id="health-emblem" aria-label='@($"Health {c.CurrentHp} of {c.MaximumHp}")'><svg viewBox="0 0 80 72" aria-hidden="true"><path d="M40 68C20 52 3 39 3 22C3 2 29 -1 40 15C51 -1 77 2 77 22C77 39 60 52 40 68Z" /></svg><strong>@c.CurrentHp<small>/ @c.MaximumHp</small></strong></div><div class="health-buttons"><button class="text-link damage-button" data-testid="quick-damage" disabled="@Session.IsBusy" @onclick="()=>OpenHealth(HealthChangeKind.Damage)">Damage</button><button class="text-link" data-testid="quick-heal" disabled="@(Session.IsBusy||c.CurrentHp==c.MaximumHp)" @onclick="()=>OpenHealth(HealthChangeKind.Healing)">Heal</button>@if(c.TemporaryHp>0){<small>+@c.TemporaryHp temp</small>}</div><div class="ac-emblem" aria-label='@($"Armor class {c.ArmorClass}")'><svg viewBox="0 0 64 76" aria-hidden="true"><path d="M5 5L32 1L59 5V37C59 55 46 68 32 74C18 68 5 55 5 37Z" /></svg><strong>@c.ArmorClass<small>AC</small></strong></div></div>
                    <div class="player-actions">@if(CombatActive(c)){<span class="combat-mode-chip" data-testid="combat-header-state">Combat · Round @c.Combat.Round</span>}<button class="button" data-testid="add-note" @onclick="OpenNote">Add note +</button><details class="player-menu rest-menu"><summary class="button">Rest</summary><div class="player-menu-items"><button class="button" data-testid="short-rest" disabled="@(Session.IsBusy||c.CurrentHp==0)" @onclick="()=>Rest(RestKind.Short)">Short rest</button><button class="button" data-testid="long-rest" disabled="@(Session.IsBusy||c.CurrentHp==0)" @onclick="()=>Rest(RestKind.Long)">Long rest</button>@if(c.CurrentHp==0){<small>At least 1 HP is required to rest.</small>}</div></details></div>
                    <div class="player-state"><button class="text-link" data-testid="heroic-held-indicator" aria-label="Heroic Inspiration" @onclick="OpenSurvival">@(SheetRules.HasHeroicInspiration(c)?"Inspiration ●":"Inspiration ○")</button><button class="text-link" data-testid="manage-effects" @onclick="OpenEffects">@ConditionSummary(c)</button>@if(c.Effects.Any(e=>e.Concentration)){<span>Concentrating: @c.Effects.First(e=>e.Concentration).Name</span>}@if(!string.IsNullOrWhiteSpace(c.Play.HunterTarget)&&c.Effects.Any(e=>e.Concentration&&e.Source=="spell:hunters-mark")){<button class="text-link" data-testid="move-mark" disabled="@Session.IsBusy" @onclick="MoveMark">Move Hunter’s Mark</button>}<span class='@("save-state"+(Session.SaveStatus=="Saved"?" is-saved":""))' data-testid="save-status" role="status">@Session.SaveStatus</span><span class="sr-only" aria-hidden="true" data-testid="revision">@Session.Snapshot!.Revision</span></div>
                </header>
                <section class="player-resource-bar" data-testid="resource-strip" aria-label="Resources, spell slots and Hit Dice">
                    <ResourceCounters Layout="vertical" ExcludeSpellSlots="@(!CombatActive(c))" Character="c" Busy="Session.IsBusy" OnAdjust="AdjustResource" OnAdjustHitDiePool="AdjustHitDiePool" /><CharacterStatusPanels Character="c" OnConditions="OpenEffects" OnDefenses="()=>OpenDefenses()" OnRemoveEffect="RemoveEffect" />@if(!string.IsNullOrWhiteSpace(c.KnownTarget.Name)||c.KnownTarget.Knowledge!="unknown"){<section class="panel known-target-tool" aria-label="Target defenses"><div class="panel-heading"><h2>@(string.IsNullOrWhiteSpace(c.KnownTarget.Name)?"Target":c.KnownTarget.Name)</h2><button class="text-link" @onclick="()=>OpenDefenses(true)">Edit</button></div>@if(c.KnownTarget.Knowledge=="none"){<p class="small muted">No special defenses</p>}else if(c.KnownTarget.Defenses.Count>0){<DefenseSummary Defenses="c.KnownTarget.Defenses" />}else{<p class="small muted">Defenses not checked</p>}</section>}else{<button class="text-link target-defense-shortcut" data-testid="target-defenses" @onclick="()=>OpenDefenses(true)">Target defenses</button>}
                    <div class="player-resource-tools"><button class="text-link" data-testid="undo-play" disabled="@(Session.IsBusy||c.Play.UndoHistory.Count==0)" title="@(c.Play.UndoHistory.LastOrDefault()?.Description??"No play change to undo")" @onclick="Undo">Undo last change</button></div>
                </section>
            </div>
            <nav class="sheet-tool-nav" aria-label="Character tools">@foreach(var destination in Destinations){<button type="button" class="button" aria-current="@(View==destination.Key?"page":null)" data-testid='@("nav-"+destination.Key)' @onclick="()=>Navigate(destination.Key)"><SheetGlyph Name="@destination.Symbol" />@destination.Title</button>}@if(Features.Combat&&View!="library"&&Session.Workflow is null&&!c.Combat.Enabled){<button class="button combat-toggle" data-testid="enter-combat" disabled="@Session.IsBusy" @onclick="()=>CombatPanel?.BeginEntryAsync()??Task.CompletedTask"><SheetGlyph Name="swords" />@(c.Combat.EncounterActive?"Resume combat":"Enter combat mode")</button>}</nav>
            <main class="content" id="main" data-testid='@(Interactive?"workspace-ready":"workspace-loading")'>
                @if(SelectionNotice is not null){<p class="reference-line">@SelectionNotice</p>}
                @if(Session.Workflow is not null&&ShowWorkflow){<CharacterWorkflow Session="Session" OnFinished="WorkflowFinished" />}
                else
                {
                    @if(Session.Workflow is not null){<div class="draft-resume"><span>A character draft is in progress.</span><button class="text-link" @onclick="ResumeWorkflow">Resume draft →</button></div>}
                    @if(View=="library")
                    {
                        <CharacterLibrary Session="Session" ShowImport="ImportOpen" OnOpened="WorkflowFinished" OnWorkflowStarted="ResumeWorkflow" />
                    }
                    else
                    {
                    @if(Features.Combat)
                    {
                    <CombatWorkspace @ref="CombatPanel" ShowEntryControl="false" @key='(c.Id,"combat-workspace")' Character="c" Busy="Session.IsBusy" OnTransition="TransitionCombat" Spells="Spells" OnCast="CastSpell" OnSkill="CombatSkill" OnSave="CombatSave" OnItem="CombatItem" OnResumeRoll="ResumeCombatRoll" OnResumeCast="ResumeCombatCast" OnSurvival="OpenSurvival">
                        @foreach(var attack in Attacks){var bonus=CharacterCalculations.Attack(c,attack.Ability,attack.Proficient,attack.Flat);var option=CombatRules.AttackOption(c,attack.Key,attack.Kind);var reaction=CombatRules.ReactionAttackOption(c,attack.Key,attack.Kind);<div class="player-attack-row"><div><strong>@attack.Name</strong>@if(option.Reason.Length>0){<small>@option.Reason</small>}@if(AmmunitionLeft(attack) is {} left){<small data-testid='@("ammunition-left-"+attack.Key)'>@left</small>}</div><CalculationValue Value="bonus" Label='@(attack.Name+" attack")' /><button class="button primary" disabled="@(Session.IsBusy||!option.Allowed||OutOfAmmunition(attack))" @onclick="()=>OpenAttack(attack)">Attack</button><button class="button" disabled="@(Session.IsBusy||!reaction.Allowed||OutOfAmmunition(attack))" title="@reaction.Reason" @onclick="()=>OpenReactionAttack(attack)">Reaction attack</button></div>}
                        @foreach(var item in ThrownItems){var reason=ThrownItemRules.Reason(c,item);<div class="player-attack-row"><div><strong>@item.Name ×@item.Quantity</strong><small>@ThrownSummary(c,item)</small>@if(reason is not null){<small>@reason</small>}</div><span></span><button class="button primary" data-testid='@("throw-"+item.Id)' disabled="@(Session.IsBusy||reason is not null)" @onclick="()=>OpenThrow(item)">Throw</button></div>}
                        @if(!Attacks.Any()){<p>Equip a weapon in Inventory to use its recorded attack.</p>}
                    </CombatWorkspace>
                    }
                    @if(!CombatActive(c))
                    {
                    @if(View=="adventure")
                    {
                        <SheetReference Character="c" Busy="Session.IsBusy" OnCheck="RollAbility" OnSave="CombatSave" OnInitiative="RollInitiative" />
                        <div class="player-travel">@foreach(var mode in AdventureRules.Movement(c)){<span><strong>@mode.Kind</strong> @mode.Speed ft <small>@mode.Source</small></span>}<span><strong>Travel</strong> @CharacterCalculations.Speed(c) ft</span><span><strong>Senses</strong> @Senses</span></div>
                        <div class="context-two-column adventure-layout"><div><section class="panel play-attacks" id="play-attacks"><div class="panel-heading"><h2><SheetGlyph Name="swords" />Attacks</h2></div>@foreach(var attack in Attacks){var value=CharacterCalculations.Attack(c,attack.Ability,attack.Proficient,attack.Flat);<div class="player-attack-row"><div><div class="attack-name-line"><strong>@attack.Name</strong><span class="attack-damage-summary">@attack.Damage @attack.DamageType</span></div><AttackProperties Text="@attack.Summary" />@if(AmmunitionLeft(attack) is {} left){<small class="ammunition-left" data-testid='@("ammunition-left-"+attack.Key)'>@left</small>}</div><CalculationValue Value="value" Label='@(attack.Name+" attack")' CssClass="attack-value" /><button class="button primary" data-testid='@("roll-"+attack.Key)' disabled="@(Session.IsBusy||OutOfAmmunition(attack))" @onclick="()=>OpenAttack(attack)">Attack</button></div>}@foreach(var item in ThrownItems){var reason=ThrownItemRules.Reason(c,item);<div class="player-attack-row"><div><div class="attack-name-line"><strong>@item.Name ×@item.Quantity</strong></div><small>@ThrownSummary(c,item)</small>@if(reason is not null){<small class="rust" data-testid='@("throw-reason-"+item.Id)'>@reason</small>}</div><span></span><button class="button primary" data-testid='@("throw-"+item.Id)' disabled="@(Session.IsBusy||reason is not null)" @onclick="()=>OpenThrow(item)">Throw</button></div>}@if(!Attacks.Any()){<p>No ready weapons. Equip one in Equipment to add its attack.</p>}<p class="player-hint"></p></section><MagicPanel TestId="adventure-magic" Character="c" Spells="Spells" Busy="Session.IsBusy" OnCast="CastSpell" OnInspect="InspectSpell" OnAdjust="AdjustResource" OnAllSpells="OpenSpellLibrary" /><div class="sheet-shortcuts"><button class="text-link" @onclick="OpenReferences">Languages &amp; features →</button><button class="text-link" @onclick="OpenProfile">Profile &amp; story →</button></div></div><div><section class="panel adventure-checks"><div class="panel-heading"><h2><SheetGlyph Name="dice" />Checks &amp; skills</h2><details class="skill-help"><summary aria-label="About skill checks and passive scores">?</summary><p>Choose a skill to roll. Hover or focus a number for its breakdown. Passive = 10 + skill bonus.</p></details></div>
                            <div class="adventure-skills">@foreach(var skill in AllSkills){var value=CharacterCalculations.Skill(c,skill.Name,skill.Ability);var key=SkillKey(skill.Name);<div class="skill-row adventure-skill" data-testid='@("skill-"+key)'><button class="roll-row-action skill-name" data-testid='@("roll-skill-"+key)' aria-label='@("Roll "+skill.Name+" check")' disabled="@Session.IsBusy" @onclick='()=>OpenRoll(skill.Name+" check",value,RollKind.Skill,skill.Ability,skill.Name)'><span class='skill-dot @(c.SkillProficiencies.Contains(skill.Name)?"filled":"")' aria-hidden="true"></span><span>@skill.Name <span class='@("sheet-training "+SkillTraining(c,skill.Name).ToLowerInvariant())' data-testid='@("training-"+key)'>@SkillTraining(c,skill.Name)</span></span><small>Roll</small></button><div class="skill-totals"><span data-testid='@("active-"+key)'><CalculationValue Value="value" Label='@(skill.Name+" check bonus")' CssClass="skill-calculation-total" /></span>@if(HasPassiveReference(skill.Name)){<span class="inline-passive"><span>Passive</span><span data-testid='@("passive-"+key)'><CalculationValue Value="PassiveSkill(c,skill.Name,skill.Ability)" Label='@("Passive "+skill.Name)' Unsigned="true" /></span></span>}</div></div>}</div>
                        </section></div></div>
                        <section class="panel context-adventure-bottom"><div class="panel-heading"><h2>Recent journal</h2><button class="text-link" @onclick='()=>Navigate("journal")'>Open journal →</button></div><NoteList Notes="c.Notes.Where(n=>!archivedNoteIds.Contains(n.Id)).OrderByDescending(n=>n.CreatedAt).Take(3)" /></section>
                    }
                    else if(View=="equipment")
                    {
                        <section class="inventory-view" aria-labelledby="inventory-title"><h2 id="inventory-title" class="view-title"><SheetGlyph Name="pack" />Inventory</h2>@{var load=AdventureRules.Carrying(c);}<p class="reference-line" data-testid="inventory-weight">@load.KnownWeightLb.ToString("0.##") lb known / @load.CapacityLb.ToString("0.##") lb capacity @if(!load.Complete){<strong>· Incomplete weights (@load.UnweighedItems items unweighed)</strong>}@if(load.OverCapacity){<strong class="rust">· Over carrying capacity</strong>}</p><div class="sheet-shortcuts"><button class="button" @onclick="OpenPurse">Coin purse</button><button class="button" @onclick="()=>OpenItem()">Add item +</button><button class="text-link" @onclick="OpenAdventure">Capacity settings</button></div>                        <AmmunitionPanel Character="c" Session="Session" /><p class="player-hint">Carried items stay in your pack. Equip or attune gear to activate its modeled bonuses.</p><div class="inventory-grid">@foreach(var item in c.Equipment){<div class="panel inventory-item" data-item-id="@item.Id"><div class="panel-heading"><div><div class="section-kicker">@(item.Consumable?"Consumable":item.Equipped?"Equipped":"Backpack")</div><h2>@item.Name</h2>@if(item.ScrollSpell.Length>0){<p class="reference-line" data-testid='@("scroll-spell-"+ItemKey(item))'>@item.ScrollSpell</p>}@if(item.HealingDice is not null){<p class="reference-line" data-testid='@("heals-"+ItemKey(item))'>Heals @ItemLinking.HealingText(item)</p>}<button class="text-link" @onclick="()=>OpenItem(item)">Edit item →</button></div></div><ItemDescription Text="@item.Description" /><small>@(item.UnitWeightLb is {} pounds?$"{pounds:0.##} lb each":"Weight unknown") · @(item.Carried?"Carried":"Stored elsewhere")</small>@if(item.Charges is {} charge){<div class="item-charges"><span>@charge.Remaining/@charge.Maximum charges · @charge.UseCost per use</span><button class="text-link" aria-label='@("Spend charge from "+item.Name)' disabled="@(Session.IsBusy||charge.Remaining==0)" @onclick="()=>Session.AdjustItemChargesAsync(item.Id,-1,c.Id)">−</button><button class="text-link" aria-label='@("Restore charge to "+item.Name)' disabled="@(Session.IsBusy||charge.Remaining==charge.Maximum)" @onclick="()=>Session.AdjustItemChargesAsync(item.Id,1,c.Id)">+</button><small>@charge.RecoveryNote</small></div>}<div class="inventory-actions"><div class="quantity-controls"><button class="button" disabled="@(Session.IsBusy||item.Quantity==0)" aria-label='@("Remove one "+item.Name)' @onclick="()=>Session.AdjustQuantityAsync(item.Id,-1)">−</button><strong data-testid='@("quantity-"+ItemKey(item))'>@item.Quantity</strong><button class="button" disabled="@Session.IsBusy" aria-label='@("Add one "+item.Name)' @onclick="()=>Session.AdjustQuantityAsync(item.Id,1)">+</button></div>@if(item.Consumable||item.UseEffects.Count>0||item.Charges is not null){<button class="button" data-testid='@("consume-"+ItemKey(item))' disabled="@(Session.IsBusy||item.Quantity==0||item.Charges is {} available&&available.Remaining<available.UseCost)" @onclick="()=>OpenItemUse(item)">@(item.Consumable?"Use one":"Use item")</button>}</div>@if(!item.Consumable){<div class="equipment-switches"><label><input type="checkbox" data-testid='@("equip-"+item.Id)' checked="@item.Equipped" disabled="@(Session.IsBusy||item.Quantity==0)" @onchange="e=>Session.SetEquipmentAsync(item.Id,Checked(e),item.Attuned)" /> Equipped</label>@if(item.RequiresAttunement){<label><input type="checkbox" data-testid='@("attune-"+item.Id)' checked="@item.Attuned" disabled="@(Session.IsBusy||item.Quantity==0)" @onchange="e=>Session.SetEquipmentAsync(item.Id,item.Equipped,Checked(e))" /> Attuned</label>}</div>}@if(item.ModifierBonuses.Count>0){<p class="item-bonus">@string.Join(" · ",item.ModifierBonuses.Select(b=>$"{b.Key} modifier {Signed(b.Value)}")) <span class="tag">@(item.Quantity>0&&item.Equipped&&(!item.RequiresAttunement||item.Attuned)?"Active":"Inactive")</span></p>}</div>}</div></section>
                    }
                    else if(View=="companions")
                    {
                        var carrying=AdventureRules.Carrying(c);
                        <div class="companions-view">
                            <section class="panel travel-summary"><div class="panel-heading"><h2><SheetGlyph Name="compass" />Travel</h2><button class="text-link" data-testid="open-adventure-facts" @onclick="OpenAdventure">Edit travel &amp; carrying →</button></div><div class="player-travel">@foreach(var mode in AdventureRules.Movement(c)){<span><strong>@mode.Kind</strong> @mode.Speed ft <small>@mode.Source</small></span>}<span><strong>Travel</strong> @CharacterCalculations.Speed(c) ft</span><span><strong>Senses</strong> @Senses</span></div><p class="small muted">Carrying @carrying.KnownWeightLb.ToString("0.##") of @carrying.CapacityLb.ToString("0.##") lb</p></section>
                            @if(c.Sheet.Adventure.Companions.Count==0){<section class="panel companion-empty"><div class="panel-heading"><h2>Companions</h2><button class="text-link" data-testid="add-companion" @onclick="OpenAdventure">Add companion →</button></div><p class="small muted">Familiars, summons and animal companions you add appear here with their HP and AC.</p></section>}
                            <CompanionPanel Character="c" Session="Session" OnEdit="OpenAdventure" />
                        </div>
                    }
                    }
                    }
                }
            </main>
            <dialog id="spell-library-dialog" class="dialog sheet-tool-dialog" aria-labelledby="spell-library-title"><div class="dialog-inner"><div class="dialog-heading"><h2 id="spell-library-title">Spell reference</h2><button class="icon-button" aria-label="Close spell reference list" @onclick='()=>CloseDialog("spell-library-dialog")'>×</button></div>                        <MagicCastingSummary Character="c" OnAttack="RollSpellAttack" /><div class="player-spell-toolbar"><label class="journal-search"><span class="sr-only">Search spells</span><input data-testid="spell-search" type="search" placeholder="Find a spell…" @bind="SpellSearch" @bind:event="oninput" /></label><label class="field">Spell level<select data-testid="spell-level-filter" @bind="SpellLevelFilter"><option value="all">All levels</option><option value="0">Cantrips</option>@foreach(var level in Spells.Where(s=>s.Level>0).Select(s=>s.Level).Distinct().Order()){<option value="@level">Level @level</option>}</select></label><button class="text-link" @onclick="()=>OpenDefenses()">Your defenses</button></div>
                        @foreach(var group in FilteredSpells.GroupBy(s=>s.Level).OrderBy(g=>g.Key)){<section class="panel player-spell-group"><div class="panel-heading"><h2>@(group.Key==0?"Cantrips":$"Level {group.Key}")</h2><span class="small">@group.Count() ready</span></div>@foreach(var spell in group){<div class="spell-reference-row"><button class="roll-row-action" @onclick="()=>InspectSpell(spell)"><strong>@spell.Name</strong><small>@SpellSummary(spell)</small></button><button class="button" data-testid='@("cast-"+spell.Id)' disabled="@Session.IsBusy" @onclick="()=>CastSpell(spell)">Cast</button></div>}</section>}
                        @if(!FilteredSpells.Any()){<div class="panel player-empty"><h2>@(Spells.Any()?"No matching spells":"No spells ready")</h2><p>@(Spells.Any()?"Try another name or spell level.":"Prepared, known and granted spells will appear here.")</p></div>}</div></dialog>
                        <dialog id="journal-sheet-dialog" class="dialog sheet-tool-dialog" aria-labelledby="journal-sheet-title"><div class="dialog-inner"><div class="dialog-heading"><h2 id="journal-sheet-title">Journal</h2><button class="icon-button" aria-label="Close journal" @onclick='()=>CloseDialog("journal-sheet-dialog")'>×</button></div><JournalPanel Session="Session" OnAdd="OpenJournalNote" OnAddCategory="OpenJournalNote" /></div></dialog>
            <ItemUseDialog Session="Session" PreferredDiceMode="PreferredDiceMode" @ref="ItemUse" /><ThrowDialog Session="Session" PreferredDiceMode="PreferredDiceMode" @ref="ThrowItem" />
            <AdventureDialog Session="Session" @ref="Adventure" />
            <WorkspaceDialogs @key='(c.Id,"workspace-dialogs")' Character="c" Session="Session" OnWorkflowStarted="ResumeWorkflow" @ref="Dialogs" />
            <GameplayDialogs @key='(c.Id,"gameplay-dialogs")' Character="c" Session="Session" OnHealingRequested="OpenHealingFromSpell" PreferredDiceMode="PreferredDiceMode" QuickRoll="true" OnRollOptionsChanged="RefreshRollOptions" @ref="Gameplay" />
            <InventoryDefenseDialogs @key='(c.Id,"inventory-dialogs")' Session="Session" @ref="InventoryDialogs" />
            <OwnedReferencesDialog @key='(c.Id,"owned-references")' Character="c" Session="Session" OnEditProfile="OpenProfile" @ref="References" />
            <SurvivalDialog @key='(c.Id,"survival-dialog")' Session="Session" PreferredDiceMode="PreferredDiceMode" OnTemporaryHp="()=>OpenHealth(HealthChangeKind.TemporaryHp)" @ref="Survival" />
            <PurseDialog @key='(c.Id,"purse-dialog")' Session="Session" @ref="Purse" />
            <ProfileDialog @key='(c.Id,"profile-dialog")' Session="Session" @ref="Profile" />
            <HealthDialog @key='(c.Id,"health-dialog")' Character="c" Session="Session" @ref="Health" />
            <SpellInspector Session="Session" Busy="Session.IsBusy" OnCast="CastSpell" @ref="SpellDetails" />
        }
        else
        {
            <main class="content loading-panel"><h1>Opening your character.</h1><p>Your saved workspace is loading.</p>@if(Session.Error is not null){<button class="button primary" @onclick="Reload">Try again</button>}</main>
        }
    </div>
</div>
